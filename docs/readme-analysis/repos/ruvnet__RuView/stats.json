      },
      {
        "level": 2,
        "text": "\ud83e\udde0 Self-Learning WiFi AI",
        "category": "other"
      },
      {
        "level": 1,
        "text": "Step 1: Learn from raw WiFi data (no labels needed)",
        "category": "other"
