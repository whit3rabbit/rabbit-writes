        "text": "GEMINI_API_KEY=...",
        "category": "other"
      },
      {
        "level": 1,
        "text": "OPENROUTER_API_KEY=...",
        "category": "other"
      },
      {
        "level": 1,
        "text": "MINIMAX_API_KEY=...",
        "category": "other"
      },
      {
        "level": 1,
        "text": "OPENAI_API_KEY=***                       # NOTE: this same key auto-activates BOTH the",
        "category": "other"
      },
      {
        "level": 1,
        "text": "# OpenAI LLM provider (here) AND the OpenAI",
        "category": "other"
      },
      {
        "level": 1,
        "text": "# embedding provider (further below). Set",
        "category": "other"
      },
      {
        "level": 1,
        "text": "# OPENAI_API_KEY_FOR_LLM=false to scope it",
        "category": "other"
      },
      {
        "level": 1,
        "text": "# to embeddings only.",
        "category": "other"
      },
      {
        "level": 1,
        "text": "OPENAI_BASE_URL=https://api.openai.com   # Optional: override for Azure / vLLM / LM Studio / proxies",
        "category": "api"
      },
      {
        "level": 1,
        "text": "# Azure: https://<resource>.openai.azure.com/openai/deployments/<deployment>",
        "category": "other"
      },
      {
        "level": 1,
        "text": "# Auto-detected from `.openai.azure.com` hostname; uses",
        "category": "other"
      },
      {
        "level": 1,
        "text": "# api-key header + api-version query param.",
        "category": "other"
      },
      {
        "level": 1,
        "text": "OPENAI_API_VERSION=2024-08-01-preview    # Optional: Azure api-version query param",
        "category": "demo"
      },
      {
        "level": 1,
        "text": "OPENAI_MODEL=gpt-4o-mini                 # Optional: default model",
        "category": "other"
      },
      {
        "level": 1,
        "text": "OPENAI_TIMEOUT_MS=60000                  # Optional: OpenAI-scoped alias for the outbound fetch",
        "category": "other"
      },
      {
        "level": 1,
        "text": "# timeout. Takes precedence over AGENTMEMORY_LLM_TIMEOUT_MS",
        "category": "other"
      },
      {
        "level": 1,
        "text": "# for back-compat with v0.9.17. New configs should",
        "category": "configuration"
      },
      {
        "level": 1,
        "text": "# prefer the global AGENTMEMORY_LLM_TIMEOUT_MS below.",
        "category": "other"
      },
      {
        "level": 1,
        "text": "OPENAI_REASONING_EFFORT=none             # Optional: \"low\" | \"medium\" | \"high\" | \"none\"",
        "category": "other"
      },
      {
        "level": 1,
        "text": "# Honored only by OpenAI's reasoning models (o1, o3,",
        "category": "other"
      },
      {
        "level": 1,
        "text": "# gpt-*-reasoning) and providers that mirror that",
        "category": "other"
      },
      {
        "level": 1,
        "text": "# schema (Ollama Cloud thinking models). Standard",
        "category": "other"
      },
      {
        "level": 1,
        "text": "# chat models reject this field with 400. Set to",
        "category": "other"
      },
      {
        "level": 1,
        "text": "# \"none\" for thinking models that return reasoning",
        "category": "other"
      },
      {
        "level": 1,
        "text": "# but no content.",
        "category": "other"
      },
      {
        "level": 1,
        "text": "OPENAI_API_KEY_FOR_LLM=false             # Optional: set to false to skip OpenAI auto-detection",
        "category": "other"
      },
      {
        "level": 1,
        "text": "# for LLM (useful if you only want OpenAI for embeddings)",
        "category": "other"
      },
      {
        "level": 1,
        "text": "Opt-in Claude-subscription fallback (spawns @anthropic-ai/claude-agent-sdk);",
        "category": "other"
      },
      {
        "level": 1,
        "text": "leave OFF unless you understand the Stop-hook recursion risk:",
        "category": "other"
      },
      {
        "level": 1,
        "text": "AGENTMEMORY_ALLOW_AGENT_SDK=true",
        "category": "other"
      },
      {
        "level": 1,
        "text": "Embedding provider (auto-detected, or override)",
        "category": "other"
      },
      {
        "level": 1,
        "text": "EMBEDDING_PROVIDER=local",
        "category": "other"
      },
      {
        "level": 1,
        "text": "VOYAGE_API_KEY=...",
        "category": "other"
      },
      {
        "level": 1,
        "text": "OPENAI_API_KEY=sk-...",
        "category": "other"
      },
      {
        "level": 1,
        "text": "OPENAI_BASE_URL=https://api.openai.com   # Override for Azure / vLLM / LM Studio / proxies",
        "category": "api"
      },
      {
        "level": 1,
        "text": "OPENAI_EMBEDDING_MODEL=text-embedding-3-small",
        "category": "other"
      },
      {
