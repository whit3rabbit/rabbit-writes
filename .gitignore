# Local search index, rebuilt on demand and machine-specific.
.syntext/

# Personal Claude Code notes and settings, machine-specific.
# settings.local.json holds per-machine permissions and skill overrides. It is
# ignored here rather than only in a contributor's global excludes, because the
# global rule is invisible to everyone else and the first clone without it
# commits somebody's local state.
CLAUDE.local.md
.claude.local.md
.claude/settings.local.json

# Labeled-corpus texts. The manifest commits a SHA-256, a source URL, and an
# archive URL for each sample; the prose itself stays with whoever wrote it.
# scripts/detector-corpus/score.py --verify refetches nothing and checks hashes,
# so a claim in the manifest is checkable without this directory being public.
docs/detector-corpus/texts/

# Reconstruction eval texts. The manifest carries hashes, the prose belongs to
# whoever wrote it, and it is not this repository's to publish.
docs/voice-eval/texts/

# Academic calibration corpus texts. The manifest commits a DOI, a license, a
# source URL, and a SHA-256 per paper, and 01_fetch_corpus.py refetches and
# verifies. CC BY would permit redistributing 20 papers. It does not oblige it,
# and hashes travel better than 800KB of somebody else's prose.
docs/academic-corpus/texts/

# Thesaurus research raw datasets (WordNet 3.1 dict files, Norvig count_1w).
# thesaurus_io.py commits each URL, SHA-256, and license, and
# 01_fetch_datasets.py refetches and verifies, so nothing here needs git.
docs/thesaurus-research/raw/

# Scratch directory
scratch/

# Packaged skill bundles, regenerated by scripts/package_skills.py into dist/.
# The pattern also catches a stray copy left at the root by an older packager.
*.zip

docs-best-practices/