    "section_order_detail": [
      {
        "level": 1,
        "text": "\u03c0 RuView",
        "category": "other"
      },
      {
        "level": 2,
        "text": "**See through walls with WiFi** ##",
        "category": "other"
      },
      {
        "level": 3,
        "text": "\u03c0 RuView is a WiFi sensing platform that turns radio signals into spatial intelligence.",
        "category": "other"
      },
      {
        "level": 1,
        "text": "Check the local setup and get source-cited guidance",
        "category": "installation"
      },
      {
        "level": 1,
        "text": "Run a read-only RuView agent through Codex",
        "category": "other"
      },
      {
        "level": 1,
        "text": "Search or verify the reviewed contributor brain",
        "category": "other"
      },
      {
        "level": 1,
        "text": "Check claims, replay the deterministic proof, or expose the MCP server",
        "category": "other"
      },
      {
        "level": 3,
        "text": "Built for low-power edge applications",
        "category": "other"
      },
      {
        "level": 1,
        "text": "Option 1: Docker (simulated data, no hardware needed)",
        "category": "other"
      },
      {
        "level": 1,
        "text": "Open http://localhost:3000",
        "category": "other"
      },
      {
        "level": 1,
        "text": "Option 2a: Live sensing with ESP32-S3 hardware ($9)",
        "category": "other"
      },
      {
        "level": 1,
        "text": "Flash firmware, provision WiFi, and start sensing:",
        "category": "other"
      },
      {
        "level": 1,
        "text": "Option 2b: WiFi 6 + 802.15.4 research sensing with ESP32-C6 ($6-10, ADR-110)",
        "category": "other"
      },
      {
        "level": 1,
        "text": "Same csi-node firmware compiled for the C6 target \u2014 picks up the C6",
        "category": "other"
      },
      {
        "level": 1,
        "text": "overlay (sdkconfig.defaults.esp32c6) automatically.",
        "category": "configuration"
      },
      {
        "level": 1,
        "text": "C6 boot extras (vs S3): HE-LTF subcarrier tagging in ADR-018 bytes 18-19,",
        "category": "other"
      },
      {
        "level": 1,
        "text": "802.15.4 mesh time-sync on channel 15, TWT setup when the AP supports it,",
        "category": "installation"
      },
      {
        "level": 1,
        "text": "opt-in LP-core wake-on-motion for ~5 \u00b5A battery seed nodes.",
        "category": "other"
      },
      {
        "level": 1,
        "text": "v0.6.7 adds: real LP-core RISC-V motion-gate program (debounce + motion",
        "category": "other"
      },
      {
        "level": 1,
        "text": "counter) and a Wi-Fi 6 soft-AP with TWT Responder so two C6 boards can",
        "category": "other"
      },
      {
        "level": 1,
        "text": "benchmark real iTWT without buying an 11ax router. Both default off,",
        "category": "performance"
      },
      {
        "level": 1,
        "text": "flip CONFIG_C6_{LP_CORE,SOFTAP_HE}_ENABLE to turn them on.",
        "category": "configuration"
      },
      {
        "level": 1,
        "text": "Option 3: Full system with Cognitum Seed ($140)",
        "category": "other"
      },
      {
        "level": 1,
        "text": "ESP32 streams CSI \u2192 bridge forwards to Seed for persistent storage + kNN + witness chain",
        "category": "other"
      },
      {
        "level": 1,
        "text": "Option 4: Python \u2014 live on PyPI (ADR-117)",
        "category": "other"
      },
      {
        "level": 1,
        "text": "Both ship the same compiled PyO3 wheel (~250 KB, abi3-py310, Linux/macOS/Windows).",
        "category": "other"
      },
      {
        "level": 1,
        "text": "Add [client] for the asyncio WebSocket + paho-mqtt clients:",
        "category": "other"
      },
      {
        "level": 1,
        "text": "from ruview import BreathingExtractor, HeartRateExtractor   # equivalent to:",
        "category": "other"
      },
      {
        "level": 1,
        "text": "from wifi_densepose import BreathingExtractor, HeartRateExtractor",
        "category": "other"
      },
      {
        "level": 1,
        "text": "from ruview.client import SensingClient, RuViewMqttClient",
        "category": "other"
      },
      {
        "level": 2,
        "text": "\ud83e\udd17 Pretrained model on Hugging Face",
        "category": "other"
      },
      {
        "level": 1,
        "text": "Download the model bundle",
        "category": "other"
      },
